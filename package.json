{
  "name": "pokeportal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "core",
    "tests",
    "web"
  ],
  "scripts": {
    "test": "vitest run && bun run --cwd web test",
    "test:watch": "vitest",
    "typecheck": "tsc --build && tsc --noEmit -p web/tsconfig.json",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.7.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^9.12.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.8.0",
    "vitest": "^2.1.2"
  }
}
